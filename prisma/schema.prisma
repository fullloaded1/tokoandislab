generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  category           String
  categoryLabel      String
  brand              String
  model              String
  subcategory        String
  image              String
  description        String
  price              Decimal             @default(0) @db.Decimal(16, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isRequestPricing   Boolean             @default(false)
  leadTime           String?
  warrantyPeriod     String?
  brochureUrl        String?
  isReadyStock       Boolean             @default(false)
  costPrice          Decimal             @default(0) @db.Decimal(16, 2)
  clearanceDiscount  Decimal?            @db.Decimal(5, 2)
  pageViews          Int                 @default(0)
  documentKnowledges DocumentKnowledge[]
  inquiryItems       InquiryItem[]
  installedBases     InstalledBase[]
  specs              ProductSpec[]
  variants           ProductVariant[]
  whatsAppLogs       WhatsAppLog[]
  articles           Article[]           @relation("ArticleToProduct")
  evalItems          StockEvalItem[]
}

model ProductVariant {
  id             String             @id @default(cuid())
  productId      String
  sku            String             @unique
  name           String
  price          Decimal            @default(0) @db.Decimal(16, 2)
  stock          Int                @default(0)
  reservedStock  Int                @default(0)
  sortOrder      Int                @default(0)
  orderItems     OrderItem[]
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]
  stockLogs      StockLog[]
  reservations   StockReservation[]

  @@index([sku])
  @@index([productId])
}

model StockLog {
  id        String         @id @default(cuid())
  variantId String
  type      StockLogType
  quantity  Int
  notes     String?
  actorId   String?
  createdAt DateTime       @default(now())
  actor     AdminUser?     @relation(fields: [actorId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([actorId])
}

model StockReservation {
  id        String         @id @default(cuid())
  variantId String
  orderId   String?
  quantity  Int
  expiresAt DateTime
  createdAt DateTime       @default(now())
  order     Order?         @relation(fields: [orderId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([expiresAt])
}

model Customer {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String?
  name          String
  phone         String?
  institutionId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        CustomerStatus @default(GUEST)
  institution   Institution?   @relation(fields: [institutionId], references: [id])
  orders        Order[]

  @@index([email])
}

model Institution {
  id             String          @id @default(cuid())
  name           String          @unique
  address        String
  createdAt      DateTime        @default(now())
  npwp           String?
  phone          String?
  updatedAt      DateTime        @default(now()) @updatedAt
  type           InstitutionType @default(OTHER)
  activityLogs   ActivityLog[]
  contacts       Contact[]
  customers      Customer[]
  inquiries      Inquiry[]
  installedBases InstalledBase[]
}

model Contact {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  position      String?
  phone         String
  email         String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

model Inquiry {
  id            String        @id @default(cuid())
  inquiryNo     String        @unique
  institutionId String
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  status        InquiryStatus @default(NEW)
  activityLogs  ActivityLog[]
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  items         InquiryItem[]
  project       Project?
  quotation     Quotation?

  @@index([institutionId])
  @@index([inquiryNo])
}

model InquiryItem {
  id        String  @id @default(cuid())
  inquiryId String
  productId String
  quantity  Int
  notes     String?
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([inquiryId])
}

model Quotation {
  id           String          @id @default(cuid())
  inquiryId    String          @unique
  quoteNo      String          @unique
  subtotal     Decimal         @db.Decimal(16, 2)
  tax          Decimal         @db.Decimal(16, 2)
  shippingFee  Decimal         @default(0) @db.Decimal(16, 2)
  totalAmount  Decimal         @db.Decimal(16, 2)
  validUntil   DateTime
  paymentTerms String
  leadTime     String
  pdfUrl       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  status       QuotationStatus @default(SENT)
  orders       Order[]
  inquiry      Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  items        QuotationItem[]

  @@index([quoteNo])
}

model QuotationItem {
  id          String          @id @default(cuid())
  quotationId String
  variantId   String?
  productId   String?
  name        String
  price       Decimal         @db.Decimal(16, 2)
  quantity    Int
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quotationId])
}

model Project {
  id         String        @id @default(cuid())
  inquiryId  String        @unique
  projectNo  String        @unique
  poNumber   String
  poDocument String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  status     ProjectStatus @default(WAITING_DP)
  deliveries Delivery[]
  invoices   Invoice[]
  inquiry    Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([projectNo])
}

model Invoice {
  id           String        @id @default(cuid())
  projectId    String?
  invoiceNo    String        @unique
  amount       Decimal       @db.Decimal(16, 2)
  dueDate      DateTime
  paymentProof String?
  createdAt    DateTime      @default(now())
  paidAmount   Decimal       @default(0) @db.Decimal(16, 2)
  paidAt       DateTime?
  updatedAt    DateTime      @default(now()) @updatedAt
  type         InvoiceType   @default(FULL)
  status       InvoiceStatus @default(UNPAID)
  taxInvoiceNo String?
  taxRate      Decimal       @default(11) @db.Decimal(5, 2)
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([orderId])
  @@index([invoiceNo])
  @@index([status])
}

model Delivery {
  id          String         @id @default(cuid())
  projectId   String
  deliveryNo  String         @unique
  driverName  String?
  trackingUrl String?
  shippedDate DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  status      DeliveryStatus @default(PREPARING)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InstalledBase {
  id               String      @id @default(cuid())
  institutionId    String
  productId        String
  serialNumber     String?
  installationDate DateTime
  warrantyExpiry   DateTime
  lastMaintenance  DateTime?
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id])
  reminders        Reminder[]

  @@index([institutionId])
  @@index([productId])
}

model Reminder {
  id              String         @id @default(cuid())
  installedBaseId String
  dueDate         DateTime
  type            ReminderType   @default(OTHER)
  status          ReminderStatus @default(PENDING)
  installedBase   InstalledBase  @relation(fields: [installedBaseId], references: [id], onDelete: Cascade)

  @@index([installedBaseId])
}

model ActivityLog {
  id            String         @id @default(cuid())
  inquiryId     String?
  institutionId String?
  description   String
  createdAt     DateTime       @default(now())
  action        ActivityAction @default(OTHER)
  inquiry       Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  institution   Institution?   @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([institutionId])
}

model ChatLog {
  id          String   @id @default(cuid())
  sessionId   String
  userMessage String
  aiResponse  String?
  agent       String   @default("sales")
  createdAt   DateTime @default(now())
}

model DocumentKnowledge {
  id        String                 @id @default(cuid())
  productId String?
  title     String
  content   String
  embedding Unsupported("vector")?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now()) @updatedAt
  product   Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WhatsAppLog {
  id              String            @id @default(cuid())
  source          String
  productName     String?
  productId       String?
  inquiryNo       String?
  messageText     String?
  createdAt       DateTime          @default(now())
  leadInstitution String?
  leadName        String?
  leadPhone       String?
  status          WhatsAppLogStatus @default(NEW)
  product         Product?          @relation(fields: [productId], references: [id])
}

model Article {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  content   String
  excerpt   String?
  image     String?
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  category  String    @default("edukasi-lab")
  viewCount Int       @default(0)
  likeCount Int       @default(0)
  products  Product[] @relation("ArticleToProduct")
}

model Order {
  id                        String             @id @default(cuid())
  orderNo                   String             @unique
  orderType                 OrderType          @default(DIRECT)
  customerId                String
  status                    OrderStatus        @default(PENDING_PAYMENT)
  subtotal                  Decimal            @db.Decimal(16, 2)
  taxAmount                 Decimal            @db.Decimal(16, 2)
  shippingFee               Decimal            @default(0) @db.Decimal(16, 2)
  totalAmount               Decimal            @db.Decimal(16, 2)
  paidAmount                Decimal            @default(0) @db.Decimal(16, 2)
  paymentMethod             PaymentMethod
  paymentUrl                String?
  poDocumentUrl             String?
  taxInvoiceNo              String?
  shippingAddress           String
  shippingRegion            String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  guestAccessToken          String?            @unique
  priceDisplayMode          PriceDisplayMode   @default(EXCLUDE_PPN)
  shippedAt                 DateTime?
  trackingNumber            String?
  guestAccessTokenExpiresAt DateTime?
  quotationId               String?
  invoices                  Invoice[]
  customer                  Customer           @relation(fields: [customerId], references: [id])
  quotation                 Quotation?         @relation(fields: [quotationId], references: [id])
  items                     OrderItem[]
  reservations              StockReservation[]

  @@index([customerId])
  @@index([orderNo])
  @@index([quotationId])
  @@index([status])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  name      String
  sku       String?
  price     Decimal         @db.Decimal(16, 2)
  quantity  Int
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model AuditLog {
  id         String     @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actorId    String?
  oldValue   String?
  newValue   String?
  notes      String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

model AdminUser {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      String     @default("ADMIN")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs   AuditLog[]
  stockLogs   StockLog[]
  evaluations StockEvaluation[]
}

model ProductSpec {
  id        String  @id @default(cuid())
  label     String
  value     String
  productId String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum InquiryStatus {
  NEW
  REVIEWING
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  SENT
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  WAITING_DP
  IN_PRODUCTION
  SHIPPED
  INSTALLED
  COMPLETED
}

enum InvoiceType {
  DP
  TERMIN
  PELUNASAN
  FULL
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum DeliveryStatus {
  PREPARING
  ON_THE_WAY
  DELIVERED
}

enum ReminderStatus {
  PENDING
  FOLLOWED_UP
  DISMISSED
}

enum ReminderType {
  MAINTENANCE
  CALIBRATION
  WARRANTY
  OTHER
}

enum ActivityAction {
  NOTE
  CALL
  EMAIL
  MEETING
  VISIT
  OTHER
}

enum InstitutionType {
  HOSPITAL
  UNIVERSITY
  LABORATORY
  COMPANY
  GOVERNMENT
  OTHER
}

enum WhatsAppLogStatus {
  NEW
  CONTACTED
  OFFERS
  WON
  LOST
}

enum OrderStatus {
  PENDING_PAYMENT
  PARTIAL_PAID
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PAYMENT_GATEWAY
  MANUAL_TRANSFER
  TERM_OF_PAYMENT
}

enum StockLogType {
  IN
  OUT
  ADJUST
}

enum OrderType {
  DIRECT
  RFQ
}

enum CustomerStatus {
  GUEST
  REGISTERED
}

enum PriceDisplayMode {
  EXCLUDE_PPN
  INCLUDE_PPN
}

// ── Stock Evaluation (Monthly Rolling) ──────────────────────────

enum StockEvalStatus {
  DRAFT
  APPROVED
  EXECUTED
  CANCELLED
}

enum StockEvalAction {
  RETIRE
  INTRODUCE
}

model StockEvaluation {
  id         String          @id @default(cuid())
  evalNo     String          @unique // EVAL-2026-07
  period     DateTime // first day of eval month
  status     StockEvalStatus @default(DRAFT)
  targetCount Int            @default(50) // target jumlah ready stock
  notes      String?
  createdBy  String?
  approvedAt DateTime?
  executedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  admin      AdminUser?      @relation(fields: [createdBy], references: [id])
  items      StockEvalItem[]

  @@index([period])
  @@index([status])
}

model StockEvalItem {
  id               String          @id @default(cuid())
  evaluationId     String
  productId        String
  action           StockEvalAction

  // Snapshot skor (RETIRE)
  salesCount       Int             @default(0)
  inquiryCount     Int             @default(0)
  pageViews        Int             @default(0)
  currentStock     Int             @default(0)
  daysSinceLastSale Int?
  marginPercent    Decimal?        @db.Decimal(5, 2) // gross margin %
  score            Decimal         @default(0) @db.Decimal(10, 2)

  // Clearance discount (RETIRE)
  clearanceDiscount Decimal?       @db.Decimal(5, 2) // persen diskon clearance

  // Snapshot info produk
  productName      String
  productBrand     String?
  productModel     String?
  reason           String?
  createdAt        DateTime        @default(now())

  evaluation       StockEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])

  @@index([evaluationId])
  @@index([productId])
}
